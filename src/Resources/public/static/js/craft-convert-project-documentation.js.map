export default "{% block cc_doc_content %}\n<div class=\"cc-doc-content\">\n\n    {% block cc_doc_content_loading %}\n    <sw-loader v-if=\"isLoading\" />\n    {% endblock %}\n\n    {% block cc_doc_content_not_found %}\n    <div v-else-if=\"!document\" class=\"cc-doc-content__not-found\">\n        <sw-icon name=\"regular-exclamation-circle\" size=\"64px\" />\n        <h2>{{ $tc('cc-project-documentation.content.notFound') }}</h2>\n        <p>{{ $tc('cc-project-documentation.content.notFoundMessage') }}</p>\n    </div>\n    {% endblock %}\n\n    {% block cc_doc_content_body %}\n    <div v-else class=\"cc-doc-content__body\">\n        {% block cc_doc_content_article %}\n        <article\n            class=\"cc-doc-content__article\"\n            v-html=\"renderedContent\"\n        />\n        {% endblock %}\n\n        {% block cc_doc_content_pagination %}\n        <slot name=\"pagination\"></slot>\n        {% endblock %}\n\n        {% block cc_doc_content_meta %}\n        <div v-if=\"document.lastModified\" class=\"cc-doc-content__meta\">\n            <sw-icon name=\"regular-clock\" size=\"14px\" />\n            <span>{{ $tc('cc-project-documentation.content.lastUpdated') }}: {{ formattedDate }}</span>\n        </div>\n        {% endblock %}\n    </div>\n    {% endblock %}\n\n</div>\n{% endblock %}\n";