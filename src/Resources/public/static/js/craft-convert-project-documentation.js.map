export default "{% block sw_dashboard_index_content_intro_card %}\n    {% parent %}\n\n    {% block sw_dashboard_index_documentation_card %}\n    <div\n        v-if=\"canViewDocumentation\"\n        class=\"sw-dashboard-index__documentation-card\"\n    >\n        <div class=\"sw-dashboard-index__documentation-card-content\">\n            <div\n                v-if=\"hasDashboardImage\"\n                class=\"sw-dashboard-index__documentation-card-icon\"\n            >\n                <img\n                    :src=\"dashboardImageSrc\"\n                    alt=\"Documentation\"\n                />\n            </div>\n            <div class=\"sw-dashboard-index__documentation-card-text\">\n                <h3 class=\"sw-dashboard-index__documentation-card-title\">\n                    {{ $tc('cc-project-documentation.dashboard.title') }}\n                </h3>\n                <p class=\"sw-dashboard-index__documentation-card-description\">\n                    {{ $tc('cc-project-documentation.dashboard.description') }}\n                </p>\n            </div>\n            <sw-button\n                variant=\"primary\"\n                size=\"small\"\n                @click=\"navigateToDocumentation\"\n            >\n                {{ $tc('cc-project-documentation.dashboard.buttonLabel') }}\n            </sw-button>\n        </div>\n    </div>\n    {% endblock %}\n{% endblock %}\n";