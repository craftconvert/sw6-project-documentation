export default "{% block cc_doc_search %}\n<div class=\"cc-doc-search\">\n\n    {% block cc_doc_search_input %}\n    <div class=\"cc-doc-search__input-wrapper\">\n        <sw-icon name=\"regular-search\" size=\"16px\" class=\"cc-doc-search__icon\" />\n        <input\n            type=\"text\"\n            v-model=\"searchTerm\"\n            :placeholder=\"$tc('cc-project-documentation.search.placeholder')\"\n            class=\"cc-doc-search__input\"\n            @focus=\"onFocus\"\n            @blur=\"onBlur\"\n        />\n        <button\n            v-if=\"searchTerm\"\n            class=\"cc-doc-search__clear\"\n            @click=\"clearSearch\"\n        >\n            <sw-icon name=\"regular-times-xs\" size=\"12px\" />\n        </button>\n    </div>\n    {% endblock %}\n\n    {% block cc_doc_search_results %}\n    <div\n        v-if=\"showResults\"\n        class=\"cc-doc-search__results\"\n    >\n        {% block cc_doc_search_loading %}\n        <div v-if=\"isLoading\" class=\"cc-doc-search__loading\">\n            <sw-loader size=\"20px\" />\n        </div>\n        {% endblock %}\n\n        {% block cc_doc_search_no_results %}\n        <div v-else-if=\"!hasResults && searchTerm.length >= 2\" class=\"cc-doc-search__no-results\">\n            {{ $tc('cc-project-documentation.search.noResults') }}\n        </div>\n        {% endblock %}\n\n        {% block cc_doc_search_result_items %}\n        <ul v-else-if=\"hasResults\" class=\"cc-doc-search__list\">\n            <li\n                v-for=\"result in results\"\n                :key=\"result.path\"\n                class=\"cc-doc-search__item\"\n            >\n                <a\n                    href=\"#\"\n                    class=\"cc-doc-search__link\"\n                    @click.prevent=\"onSelect(result.path)\"\n                >\n                    <strong class=\"cc-doc-search__title\">{{ result.title }}</strong>\n                    <span class=\"cc-doc-search__excerpt\">{{ result.excerpt }}</span>\n                    <span class=\"cc-doc-search__path\">{{ result.path }}</span>\n                </a>\n            </li>\n        </ul>\n        {% endblock %}\n    </div>\n    {% endblock %}\n\n</div>\n{% endblock %}\n";