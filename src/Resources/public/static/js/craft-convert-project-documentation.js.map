export default "{% block cc_doc_sidebar %}\n<div class=\"cc-doc-sidebar\">\n    {% block cc_doc_sidebar_trees %}\n    <div\n        v-for=\"(tree, treeIndex) in navigationTree\"\n        :key=\"treeIndex\"\n        class=\"cc-doc-sidebar__tree\"\n    >\n        {% block cc_doc_sidebar_tree_header %}\n        <div class=\"cc-doc-sidebar__tree-header\">\n            <sw-icon :name=\"getIcon(tree)\" size=\"16px\" />\n            <span>{{ tree.label }}</span>\n        </div>\n        {% endblock %}\n\n        {% block cc_doc_sidebar_items %}\n        <ul class=\"cc-doc-sidebar__items\">\n            <li\n                v-for=\"(item, itemIndex) in tree.items\"\n                :key=\"itemIndex\"\n                class=\"cc-doc-sidebar__item\"\n            >\n                {% block cc_doc_sidebar_item_link %}\n                <template v-if=\"item.path\">\n                    <a\n                        href=\"#\"\n                        class=\"cc-doc-sidebar__link\"\n                        :class=\"{ 'is--active': isActive(item.path) }\"\n                        @click.prevent=\"onNavigate(item.path)\"\n                    >\n                        {{ item.label }}\n                    </a>\n                </template>\n                {% endblock %}\n\n                {% block cc_doc_sidebar_item_section %}\n                <template v-else-if=\"item.children\">\n                    <button\n                        class=\"cc-doc-sidebar__section-toggle\"\n                        :class=\"{ 'is--expanded': isExpanded(`${treeIndex}-${itemIndex}`) }\"\n                        @click=\"toggleSection(`${treeIndex}-${itemIndex}`)\"\n                    >\n                        <sw-icon\n                            name=\"regular-chevron-right-xs\"\n                            size=\"12px\"\n                            class=\"cc-doc-sidebar__chevron\"\n                        />\n                        <span>{{ item.label }}</span>\n                    </button>\n\n                    <ul\n                        v-if=\"isExpanded(`${treeIndex}-${itemIndex}`)\"\n                        class=\"cc-doc-sidebar__children\"\n                    >\n                        <li\n                            v-for=\"(child, childIndex) in item.children\"\n                            :key=\"childIndex\"\n                            class=\"cc-doc-sidebar__child\"\n                        >\n                            <a\n                                href=\"#\"\n                                class=\"cc-doc-sidebar__link\"\n                                :class=\"{ 'is--active': isActive(child.path) }\"\n                                @click.prevent=\"onNavigate(child.path)\"\n                            >\n                                {{ child.label }}\n                            </a>\n                        </li>\n                    </ul>\n                </template>\n                {% endblock %}\n            </li>\n        </ul>\n        {% endblock %}\n    </div>\n    {% endblock %}\n</div>\n{% endblock %}\n";