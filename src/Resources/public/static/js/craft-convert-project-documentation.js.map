export default "{% block cc_doc_set_switcher %}\n<div class=\"cc-doc-set-switcher\">\n    <sw-single-select\n        :value=\"currentSet\"\n        :options=\"setOptions\"\n        value-property=\"value\"\n        label-property=\"label\"\n        :show-clearable-button=\"false\"\n        :searchable=\"false\"\n        size=\"small\"\n        @update:value=\"onSetChange\"\n    >\n        <template #selection-label-property=\"{ item }\">\n            <div class=\"cc-doc-set-switcher__option\">\n                <sw-icon\n                    v-if=\"item.icon\"\n                    :name=\"item.icon\"\n                    size=\"16\"\n                />\n                <span>{{ item.label }}</span>\n            </div>\n        </template>\n\n        <template #result-label-property=\"{ item }\">\n            <div class=\"cc-doc-set-switcher__option\">\n                <sw-icon\n                    v-if=\"item.icon\"\n                    :name=\"item.icon\"\n                    size=\"16\"\n                />\n                <span>{{ item.label }}</span>\n            </div>\n        </template>\n    </sw-single-select>\n</div>\n{% endblock %}\n";