export default "{% block cc_project_documentation_index %}\n<sw-page class=\"cc-project-documentation-index\">\n\n    {% block cc_project_documentation_index_smart_bar_header %}\n    <template #smart-bar-header>\n        <h2>{{ $tc('cc-project-documentation.general.title') }}</h2>\n    </template>\n    {% endblock %}\n\n    {% block cc_project_documentation_index_smart_bar_actions %}\n    <template #smart-bar-actions>\n        <cc-doc-search\n            @search=\"onSearch\"\n            @select=\"onNavigate\"\n            :results=\"searchResults\"\n            :is-loading=\"isSearching\"\n        />\n    </template>\n    {% endblock %}\n\n    {% block cc_project_documentation_index_content %}\n    <template #content>\n        <sw-loader v-if=\"isLoading\" />\n\n        <div v-else class=\"cc-project-documentation-index__wrapper\">\n            {% block cc_project_documentation_index_mobile_nav %}\n            <div class=\"cc-project-documentation-index__mobile-nav\">\n                {% block cc_project_documentation_index_mobile_set_switcher %}\n                <cc-doc-set-switcher\n                    v-if=\"hasMultipleSets\"\n                    :sets=\"availableSets\"\n                    :current-set=\"currentSet\"\n                    @change=\"onSetChange\"\n                />\n                {% endblock %}\n\n                {% block cc_project_documentation_index_mobile_dropdown %}\n                <div class=\"cc-project-documentation-index__mobile-dropdown\">\n                    <button\n                        class=\"cc-project-documentation-index__mobile-toggle\"\n                        :class=\"{ 'is--open': isMobileNavOpen }\"\n                        @click=\"toggleMobileNav\"\n                    >\n                        <sw-icon name=\"regular-bars\" size=\"16px\" />\n                        <span class=\"cc-project-documentation-index__mobile-current\">\n                            <template v-if=\"currentDocumentSection && currentDocumentLabel\">\n                                <span class=\"cc-project-documentation-index__mobile-section\">{{ currentDocumentSection }}</span>\n                                <span class=\"cc-project-documentation-index__mobile-separator\">/</span>\n                            </template>\n                            {{ currentDocumentLabel || $tc('cc-project-documentation.sidebar.title') }}\n                        </span>\n                        <sw-icon\n                            :name=\"isMobileNavOpen ? 'regular-chevron-up-xs' : 'regular-chevron-down-xs'\"\n                            size=\"12px\"\n                        />\n                    </button>\n\n                    <div\n                        v-if=\"isMobileNavOpen\"\n                        class=\"cc-project-documentation-index__mobile-menu\"\n                    >\n                        <cc-doc-sidebar\n                            :navigation-tree=\"navigationTree\"\n                            :current-path=\"currentPath\"\n                            @navigate=\"onMobileNavigate\"\n                        />\n                    </div>\n                </div>\n                {% endblock %}\n            </div>\n            {% endblock %}\n\n            {% block cc_project_documentation_index_sidebar_container %}\n            <div class=\"cc-project-documentation-index__sidebar-container\">\n                {% block cc_project_documentation_index_set_switcher %}\n                <cc-doc-set-switcher\n                    v-if=\"hasMultipleSets\"\n                    :sets=\"availableSets\"\n                    :current-set=\"currentSet\"\n                    @change=\"onSetChange\"\n                />\n                {% endblock %}\n\n                {% block cc_project_documentation_index_sidebar %}\n                <div class=\"cc-project-documentation-index__sidebar\">\n                    <cc-doc-sidebar\n                        :navigation-tree=\"navigationTree\"\n                        :current-path=\"currentPath\"\n                        @navigate=\"onNavigate\"\n                    />\n                </div>\n                {% endblock %}\n            </div>\n            {% endblock %}\n\n            {% block cc_project_documentation_index_main %}\n            <div class=\"cc-project-documentation-index__main\">\n                <cc-doc-content\n                    :document=\"currentDocument\"\n                    :is-loading=\"isLoadingDocument\"\n                >\n                    {% block cc_project_documentation_index_pagination %}\n                    <template #pagination>\n                        <nav\n                            v-if=\"previousDocument || nextDocument\"\n                            class=\"cc-project-documentation-index__pagination\"\n                        >\n                            <a\n                                v-if=\"previousDocument\"\n                                href=\"#\"\n                                class=\"cc-project-documentation-index__pagination-link cc-project-documentation-index__pagination-link--prev\"\n                                @click.prevent=\"onNavigate(previousDocument.path)\"\n                            >\n                                <sw-icon name=\"regular-chevron-left-s\" size=\"20px\" />\n                                <div class=\"cc-project-documentation-index__pagination-text\">\n                                    <span class=\"cc-project-documentation-index__pagination-label\">\n                                        {{ $tc('cc-project-documentation.pagination.previous') }}\n                                    </span>\n                                    <span class=\"cc-project-documentation-index__pagination-section\">\n                                        {{ previousDocument.section }}\n                                    </span>\n                                    <span class=\"cc-project-documentation-index__pagination-title\">\n                                        {{ previousDocument.label }}\n                                    </span>\n                                </div>\n                            </a>\n\n                            <a\n                                v-if=\"nextDocument\"\n                                href=\"#\"\n                                class=\"cc-project-documentation-index__pagination-link cc-project-documentation-index__pagination-link--next\"\n                                @click.prevent=\"onNavigate(nextDocument.path)\"\n                            >\n                                <div class=\"cc-project-documentation-index__pagination-text\">\n                                    <span class=\"cc-project-documentation-index__pagination-label\">\n                                        {{ $tc('cc-project-documentation.pagination.next') }}\n                                    </span>\n                                    <span class=\"cc-project-documentation-index__pagination-section\">\n                                        {{ nextDocument.section }}\n                                    </span>\n                                    <span class=\"cc-project-documentation-index__pagination-title\">\n                                        {{ nextDocument.label }}\n                                    </span>\n                                </div>\n                                <sw-icon name=\"regular-chevron-right-s\" size=\"20px\" />\n                            </a>\n                        </nav>\n                    </template>\n                    {% endblock %}\n                </cc-doc-content>\n            </div>\n            {% endblock %}\n\n            {% block cc_project_documentation_index_toc %}\n            <div class=\"cc-project-documentation-index__toc\">\n                <cc-doc-toc\n                    v-if=\"currentDocument\"\n                    :toc=\"currentDocument.toc\"\n                />\n            </div>\n            {% endblock %}\n        </div>\n    </template>\n    {% endblock %}\n\n</sw-page>\n{% endblock %}\n";