export default "{% block cc_doc_toc %}\n<div class=\"cc-doc-toc\">\n\n    {% block cc_doc_toc_header %}\n    <div class=\"cc-doc-toc__header\">\n        {{ $tc('cc-project-documentation.toc.title') }}\n    </div>\n    {% endblock %}\n\n    {% block cc_doc_toc_list %}\n    <ul class=\"cc-doc-toc__list\">\n        <li\n            v-for=\"item in filteredToc\"\n            :key=\"item.id\"\n            class=\"cc-doc-toc__item\"\n            :class=\"getIndentClass(item.level)\"\n        >\n            <a\n                href=\"#\"\n                class=\"cc-doc-toc__link\"\n                :class=\"{ 'is--active': isActive(item.id) }\"\n                @click.prevent=\"scrollToHeading(item.id)\"\n            >\n                {{ item.text }}\n            </a>\n        </li>\n    </ul>\n    {% endblock %}\n\n</div>\n{% endblock %}\n";